.env
.env.example
.env.local

# Logs
writable/logs/*
!writable/logs/.htaccess
!writable/logs/index.html

# Cache
writable/cache/*
!writable/cache/.htaccess
!writable/cache/index.html

# Session files
writable/session/*
!writable/session/.htaccess
!writable/session/index.html

# Uploads (keep the directory structure, ignore files)
writable/uploads/*
!writable/uploads/.htaccess
!writable/uploads/index.html

# System generated files
public/uploads/*
!public/uploads/.htaccess
!public/uploads/index.html

# IDE and Editor files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Composer dependencies (if using Composer)
vendor/

# Node modules (if using frontend build tools)
node_modules/

# Testing coverage
.coverage
.phpunit.result.cache   